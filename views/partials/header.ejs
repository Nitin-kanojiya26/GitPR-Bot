<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title><%= typeof title !== 'undefined' ? title : 'Vigilentia - Autonomous AI Code Reviewer' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar" id="navbar">
    <div class="container navbar-container">
      <a href="/" class="brand" aria-label="Vigilentia Home">
        <svg height="18" width="18" viewBox="0 0 16 16" fill="currentColor" class="brand-icon">
          <path d="M7.177 3.073L9.573.677A.25.25 0 0110 .854v4.792a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm-2.25.75a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zM11 2.5h-1V4h1a1 1 0 011 1v7a1 1 0 01-1 1h-1v1.5h1a2.5 2.5 0 002.5-2.5V5A2.5 2.5 0 0011 2.5z"></path>
        </svg>
        <span class="brand-name">Vigilentia</span>
        <span class="badge badge-secondary brand-badge">AI</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>

      <!-- Navigation Menu (Desktop inline, Mobile sliding drawer) -->
      <div class="nav-menu" id="nav-menu">
        <div class="nav-links">
          <a href="/" class="nav-item <%= (locals.currentPath === '/') ? 'active' : '' %>">
            <span>Home</span>
          </a>
          <a href="/dashboard" class="nav-item <%= (locals.currentPath && locals.currentPath.startsWith('/dashboard')) ? 'active' : '' %>">
            <span>Dashboard</span>
          </a>
          <a href="/settings" class="nav-item <%= (locals.currentPath && locals.currentPath.startsWith('/settings')) ? 'active' : '' %>">
            <span>Settings</span>
          </a>
          <a href="/setup" class="nav-item <%= (locals.currentPath && locals.currentPath.startsWith('/setup')) ? 'active' : '' %>">
            <span>Setup</span>
          </a>
          <a href="/privacy" class="nav-item <%= (locals.currentPath && locals.currentPath.startsWith('/privacy')) ? 'active' : '' %>">
            <span>Privacy</span>
          </a>
        </div>

        <div class="nav-actions">
          <% if (locals.user) { %>
            <div class="user-pill">
              <% if (locals.user.avatar_url) { %>
                <img src="<%= locals.user.avatar_url %>" alt="<%= locals.user.login %>" class="avatar-sm" loading="lazy">
              <% } else { %>
                <span class="avatar-fallback"><%= (locals.user.login || 'U')[0].toUpperCase() %></span>
              <% } %>
              <span class="user-name"><%= locals.user.login %></span>
            </div>
            <a href="/auth/logout" class="btn btn-secondary btn-sm nav-btn">Sign Out</a>
          <% } else { %>
            <a href="/auth/login" class="btn btn-secondary btn-sm nav-btn">
              <svg height="14" width="14" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
              </svg>
              <span>Sign In</span>
            </a>
          <% } %>
          <a href="<%= installUrl %>" class="btn btn-primary btn-sm nav-btn nav-btn-install" target="_blank" rel="noopener">
            <span>Install on GitHub</span>
            <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" class="external-icon">
              <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
              <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile Backdrop Overlay -->
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

  <script>
    (function() {
      const toggle = document.getElementById('nav-toggle');
      const menu = document.getElementById('nav-menu');
      const backdrop = document.getElementById('nav-backdrop');

      function closeMenu() {
        if (!menu) return;
        menu.classList.remove('is-open');
        if (toggle) {
          toggle.classList.remove('is-active');
          toggle.setAttribute('aria-expanded', 'false');
        }
        if (backdrop) backdrop.classList.remove('is-active');
        document.body.classList.remove('menu-locked');
      }

      function openMenu() {
        if (!menu) return;
        menu.classList.add('is-open');
        if (toggle) {
          toggle.classList.add('is-active');
          toggle.setAttribute('aria-expanded', 'true');
        }
        if (backdrop) backdrop.classList.add('is-active');
        document.body.classList.add('menu-locked');
      }

      if (toggle && menu) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          const isOpen = menu.classList.contains('is-open');
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });
      }

      if (backdrop) {
        backdrop.addEventListener('click', closeMenu);
      }

      // Close when clicking any nav link
      if (menu) {
        menu.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', closeMenu);
        });
      }

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && menu && menu.classList.contains('is-open')) {
          closeMenu();
        }
      });
    })();
  </script>
