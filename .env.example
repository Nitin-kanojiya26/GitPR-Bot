# ==========================================
# GitHub App Authentication & Credentials
# ==========================================
APP_ID=123456
# Base64-encoded PEM or raw PEM with escaped newlines (\n)
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Or provide local file path in development:
# PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=your_github_webhook_secret_here

# In local development, use Smee proxy; in production leave empty
# WEBHOOK_PROXY_URL=https://smee.io/your-channel

# ==========================================
# GitHub App OAuth Credentials (Web UI Login)
# ==========================================
CLIENT_ID=Iv1.your_github_app_client_id
CLIENT_SECRET=your_github_app_client_secret_here
# Public facing base URL (e.g. https://gitpr-bot.onrender.com or http://localhost:3000)
BASE_URL=http://localhost:3000

# ==========================================
# Security & Session Secrets
# ==========================================
# 64-character hex key (32 bytes) for AES-256-GCM BYOK encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Session cookie signing secret
SESSION_SECRET=a_very_secure_random_string_for_cookie_sessions

# ==========================================
# Database & Cache (PostgreSQL pgvector & Redis)
# ==========================================
# PostgreSQL connection string (must have pgvector extension installed)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/reviewbot

# Redis connection string for BullMQ and webhook deduplication
REDIS_URL=redis://localhost:6380

# ==========================================
# Server Runtime
# ==========================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ==========================================
# Optional Server-Level Fallback LLM Key
# (Tenants provide their own BYOK key via Settings UI)
# ==========================================
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
