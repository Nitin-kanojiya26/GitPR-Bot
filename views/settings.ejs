<%- include('partials/header') %>

<div class="container settings-page">
  <div class="page-header">
    <div>
      <h1>Installation Settings</h1>
      <p class="subtitle">Manage your Gemini API key and customized review guide.</p>
    </div>
    <% if (installations && installations.length > 1) { %>
      <div class="installation-selector">
        <label for="inst-select">Active Account:</label>
        <select id="inst-select" onchange="window.location.href='/settings?installation_id=' + this.value">
          <% installations.forEach(function(inst) { %>
            <option value="<%= inst.installation_id %>" <%= inst.installation_id == selectedInstallationId ? 'selected' : '' %>>
              <%= inst.account_login %> (#<%= inst.installation_id %>)
            </option>
          <% }); %>
        </select>
      </div>
    <% } %>
  </div>

  <% if (success) { %>
    <div class="alert alert-success">
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 16A8 8 0 108 0a8 8 0 000 16zm3.78-9.72a.75.75 0 00-1.06-1.06L7 8.94 5.28 7.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.06 0l4.25-4.25z"></path>
      </svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-error">
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 16A8 8 0 108 0a8 8 0 000 16zM7.25 4.75a.75.75 0 011.5 0v4.5a.75.75 0 01-1.5 0v-4.5zm.75 8a1 1 0 110-2 1 1 0 010 2z"></path>
      </svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (noInstallations) { %>
    <div class="card empty-card">
      <h2>No Installed Repositories Found</h2>
      <p>GitPR has not been installed on any of your GitHub accounts yet.</p>
      <div style="margin-top: 20px;">
        <a href="<%= installUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Install GitPR on GitHub</a>
      </div>
    </div>
  <% } else if (settings) { %>
    <div class="settings-grid">
      <!-- Section 1: Gemini API Key -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2>Google Gemini API Key</h2>
            <p class="card-subtitle">Bring Your Own Key (Free Tier). Stored with AES-256-GCM encryption.</p>
          </div>
          <% if (settings.last4) { %>
            <span class="badge badge-success">Active (&bull;&bull;&bull;&bull; <%= settings.last4 %>)</span>
          <% } else { %>
            <span class="badge badge-warning">No Key Configured</span>
          <% } %>
        </div>

        <div class="card-body">
          <% if (settings.last4) { %>
            <div class="key-status-box">
              <div class="key-display">
                <span class="key-dots">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull;</span>
                <span class="key-last4"><%= settings.last4 %></span>
              </div>
              <p class="text-muted">Key is active and ready. Encrypted with random IV in database.</p>
            </div>

            <div class="key-actions">
              <details class="replace-key-details">
                <summary class="btn btn-secondary">Replace API Key</summary>
                <form action="/settings/key" method="POST" class="form-stacked" style="margin-top: 15px;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                  <div class="form-group">
                    <label for="replace_api_key">New Gemini API Key:</label>
                    <input type="password" id="replace_api_key" name="api_key" class="form-control" placeholder="AIzaSy..." required autocomplete="off">
                  </div>
                  <button type="submit" class="btn btn-primary">Test & Update Key</button>
                </form>
              </details>

              <form action="/settings/key/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this API key? Automated reviews will pause until a new key is added.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                <button type="submit" class="btn btn-danger">Delete Key</button>
              </form>
            </div>
          <% } else { %>
            <div class="no-key-guide">
              <p>GitPR requires a free Google Gemini API key to review pull requests for your repository.</p>
              <ol class="setup-steps">
                <li>Create a dedicated free key at <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener">Google AI Studio &nearr;</a></li>
                <li>Paste the key below. GitPR will ping Gemini once to verify the key, then encrypt it with AES-256-GCM.</li>
              </ol>

              <form action="/settings/key" method="POST" class="form-stacked">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                <div class="form-group">
                  <label for="new_api_key">Google Gemini API Key:</label>
                  <input type="password" id="new_api_key" name="api_key" class="form-control" placeholder="Paste your API key (starts with AIzaSy...)" required autocomplete="off">
                </div>
                <button type="submit" class="btn btn-primary">Verify & Save Key</button>
              </form>
            </div>
          <% } %>

          <div class="security-callout">
            <strong>Security Guarantee:</strong>
            <ul>
              <li>Encrypted using AES-256-GCM with a distinct 96-bit initialization vector.</li>
              <li>Decrypted only in-memory during review jobs; never logged or sent to browsers.</li>
              <li>You can rotate or delete your key at any time.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Section 2: Review Guide & Rules -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2>Review Style Guide</h2>
            <p class="card-subtitle">Custom rules embedded and retrieved with pgvector RAG.</p>
          </div>
          <span class="badge badge-info">v<%= settings.guide_version %> &bull; <%= settings.index_status || 'Pending' %></span>
        </div>

        <div class="card-body">
          <p class="text-muted" style="margin-bottom: 12px;">
            Your guide is parsed into markdown sections, converted into 768-dimensional embeddings, and semantically matched against pull request diffs.
          </p>
          <div class="guide-preview-box">
            <pre class="guide-pre"><code><%= settings.guide_md ? settings.guide_md.slice(0, 1500) + (settings.guide_md.length > 1500 ? '\n... (truncated)' : '') : 'No custom guide configured. Default rules will be used.' %></code></pre>
          </div>
          <div style="margin-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span class="text-muted" style="font-size: 0.85rem;">Last updated: <%= settings.updated_at ? new Date(settings.updated_at).toLocaleDateString() : 'Never' %></span>
            <span class="badge badge-secondary">Editable in Step 6</span>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
