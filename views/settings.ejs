<%- include('partials/header') %>

<div class="container" style="padding-bottom: 40px;">
  <div class="page-header">
    <div>
      <h1>Settings</h1>
      <p class="subtitle">Gemini API credentials and review standards.</p>
    </div>
    <% if (installations && installations.length > 1) { %>
      <div class="installation-selector">
        <select id="inst-select" onchange="window.location.href='/settings?installation_id=' + this.value">
          <% installations.forEach(function(inst) { %>
            <option value="<%= inst.installation_id %>" <%= inst.installation_id == selectedInstallationId ? 'selected' : '' %>>
              <%= inst.account_login %> (#<%= inst.installation_id %>)
            </option>
          <% }); %>
        </select>
      </div>
    <% } %>
  </div>

  <% if (success) { %>
    <div class="alert alert-success">
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-error">
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (noInstallations) { %>
    <div class="card" style="text-align: center; padding: 40px 20px;">
      <h2>No Repositories Found</h2>
      <p style="color: var(--text-muted); margin-top: 6px;">GitPR is not installed on any account.</p>
      <div style="margin-top: 16px;">
        <a href="<%= installUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Install on GitHub</a>
      </div>
    </div>
  <% } else if (settings) { %>
    <div class="settings-grid">
      <!-- Section 1: Gemini API Key -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2>Google Gemini API Key</h2>
            <p class="card-subtitle">Encrypted with AES-256-GCM.</p>
          </div>
          <% if (settings.last4) { %>
            <span class="badge badge-success">Active (&bull;&bull;&bull;&bull; <%= settings.last4 %>)</span>
          <% } else { %>
            <span class="badge badge-warning">No Key Configured</span>
          <% } %>
        </div>

        <div class="card-body">
          <% if (settings.last4) { %>
            <div class="key-status-box">
              <div class="key-display">
                <span class="key-dots">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull;</span>
                <span class="key-last4"><%= settings.last4 %></span>
              </div>

              <div class="key-actions">
                <details>
                  <summary class="btn btn-secondary btn-sm" style="cursor: pointer;">Replace Key</summary>
                  <form action="/settings/key" method="POST" style="margin-top: 10px;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                    <div class="form-group">
                      <label for="replace_api_key">New Key:</label>
                      <input type="password" id="replace_api_key" name="api_key" class="form-control" placeholder="AIzaSy..." required autocomplete="off">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Update</button>
                  </form>
                </details>

                <form action="/settings/key/delete" method="POST" onsubmit="return confirm('Delete API key? Automated reviews will pause.');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                  <button type="submit" class="btn btn-danger btn-sm">Delete Key</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <div style="margin-bottom: 16px;">
              <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px;">
                Requires a Google Gemini API key (<a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener" style="color: var(--text-main);">AI Studio &nearr;</a>).
              </p>
              <form action="/settings/key" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                <div class="form-group">
                  <input type="password" id="new_api_key" name="api_key" class="form-control" placeholder="AIzaSy..." required autocomplete="off">
                </div>
                <button type="submit" class="btn btn-primary">Save Key</button>
              </form>
            </div>
          <% } %>

          <p style="font-size: 0.75rem; color: var(--text-dim);">
            Encrypted with random 96-bit IV. Decrypted strictly in-memory during review jobs.
          </p>
        </div>
      </div>

      <!-- Section 2: Review Guide & Rules -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2>Review Style Guide</h2>
            <p class="card-subtitle">Parsed and indexed with pgvector RAG per PR.</p>
          </div>
          <% if (settings.index_status === 'indexed') { %>
            <span class="badge badge-success">Indexed (v<%= settings.guide_version %>)</span>
          <% } else if (settings.index_status === 'failed') { %>
            <span class="badge badge-danger">Failed</span>
          <% } else { %>
            <span class="badge badge-secondary"><%= settings.index_status || 'Pending' %> (v<%= settings.guide_version %>)</span>
          <% } %>
        </div>

        <div class="card-body">
          <form action="/settings/guide" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">

            <div class="form-group">
              <textarea
                name="guide_md"
                id="guide_md"
                class="form-control code-editor"
                rows="16"
                maxlength="20000"
                placeholder="# Team Style Guide&#10;&#10;## 1. Rule Title&#10;Explanation..."
                required
              ><%= settings.guide_md || '' %></textarea>
              <div class="editor-counter-bar">
                <span id="live-rule-count">Rules: 0 / 30</span>
                <span id="live-char-count">0 / 20,000</span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
              <span style="font-size: 12px; color: var(--text-muted);">
                Last saved: <%= settings.updated_at ? new Date(settings.updated_at).toLocaleDateString() : 'Never' %>
              </span>
              <button type="submit" class="btn btn-primary">Save & Re-Index Guide</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const textarea = document.getElementById("guide_md");
    const ruleCounter = document.getElementById("live-rule-count");
    const charCounter = document.getElementById("live-char-count");

    function updateStats() {
      if (!textarea) return;
      const text = textarea.value || "";
      const chars = text.length;
      const rules = (text.match(/^##\s+.+$/gm) || []).length;

      if (charCounter) {
        charCounter.textContent = `${chars.toLocaleString()} / 20,000`;
      }
      if (ruleCounter) {
        ruleCounter.textContent = `Rules: ${rules} / 30`;
      }
    }

    if (textarea) {
      textarea.addEventListener("input", updateStats);
      updateStats();
    }
  });
</script>

<%- include('partials/footer') %>
