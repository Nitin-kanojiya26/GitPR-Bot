<%- include('partials/header') %>

<div class="container settings-page">
  <div class="page-header">
    <div>
      <h1>Installation Settings</h1>
      <p class="subtitle">Manage your encrypted Gemini BYOK credentials and team review guidelines.</p>
    </div>
    <% if (installations && installations.length > 1) { %>
      <div class="installation-selector">
        <label for="inst-select" style="font-size: 0.8rem; color: var(--text-muted); margin-right: 6px;">Active Account:</label>
        <select id="inst-select" onchange="window.location.href='/settings?installation_id=' + this.value">
          <% installations.forEach(function(inst) { %>
            <option value="<%= inst.installation_id %>" <%= inst.installation_id == selectedInstallationId ? 'selected' : '' %>>
              <%= inst.account_login %> (#<%= inst.installation_id %>)
            </option>
          <% }); %>
        </select>
      </div>
    <% } %>
  </div>

  <% if (success) { %>
    <div class="alert alert-success">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 16A8 8 0 108 0a8 8 0 000 16zm3.78-9.72a.75.75 0 00-1.06-1.06L7 8.94 5.28 7.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.06 0l4.25-4.25z"></path>
      </svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-error">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 16A8 8 0 108 0a8 8 0 000 16zM7.25 4.75a.75.75 0 011.5 0v4.5a.75.75 0 01-1.5 0v-4.5zm.75 8a1 1 0 110-2 1 1 0 010 2z"></path>
      </svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (noInstallations) { %>
    <div class="card empty-card">
      <h2>No Installed Repositories Found</h2>
      <p>GitPR has not been installed on any of your GitHub accounts yet.</p>
      <div style="margin-top: 20px;">
        <a href="<%= installUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Install GitPR on GitHub</a>
      </div>
    </div>
  <% } else if (settings) { %>
    <div class="settings-grid">
      <!-- Section 1: Gemini API Key -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2>Google Gemini API Key</h2>
            <p class="card-subtitle">Bring-Your-Own-Key model. Encrypted with AES-256-GCM.</p>
          </div>
          <% if (settings.last4) { %>
            <span class="badge badge-success">Active (&bull;&bull;&bull;&bull; <%= settings.last4 %>)</span>
          <% } else { %>
            <span class="badge badge-warning">No Key Configured</span>
          <% } %>
        </div>

        <div class="card-body">
          <% if (settings.last4) { %>
            <div class="key-status-box">
              <div>
                <div class="key-display">
                  <span class="key-dots">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull;</span>
                  <span class="key-last4"><%= settings.last4 %></span>
                </div>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">Key is verified and ready. Encrypted with random 96-bit IV in PostgreSQL.</p>
              </div>

              <div class="key-actions">
                <details class="replace-key-details">
                  <summary class="btn btn-secondary btn-sm" style="cursor: pointer;">Replace Key</summary>
                  <form action="/settings/key" method="POST" class="form-stacked" style="margin-top: 15px;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                    <div class="form-group">
                      <label for="replace_api_key">New Gemini API Key:</label>
                      <input type="password" id="replace_api_key" name="api_key" class="form-control" placeholder="AIzaSy..." required autocomplete="off">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Test & Update Key</button>
                  </form>
                </details>

                <form action="/settings/key/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this API key? Automated reviews will pause until a new key is added.');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                  <button type="submit" class="btn btn-danger btn-sm">Delete Key</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <div class="no-key-guide">
              <p style="color: var(--text-secondary); font-size: 0.95rem;">GitPR requires a free Google Gemini API key to review pull requests for your repository.</p>
              <ol class="setup-steps" style="margin: 12px 0 20px 22px; color: var(--text-secondary);">
                <li style="margin-bottom: 6px;">Create a free key at <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener" style="color: #818cf8;">Google AI Studio &nearr;</a></li>
                <li style="margin-bottom: 6px;">Paste the key below. GitPR will ping Gemini once to verify the key, then encrypt it with AES-256-GCM.</li>
              </ol>

              <form action="/settings/key" method="POST" class="form-stacked">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">
                <div class="form-group">
                  <label for="new_api_key">Google Gemini API Key:</label>
                  <input type="password" id="new_api_key" name="api_key" class="form-control" placeholder="Paste your API key (starts with AIzaSy...)" required autocomplete="off">
                </div>
                <button type="submit" class="btn btn-primary">Verify & Save Key</button>
              </form>
            </div>
          <% } %>

          <div style="background-color: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: var(--radius-sm); padding: 16px; margin-top: 16px; font-size: 0.85rem;">
            <strong style="color: #a5b4fc;">Security Architecture:</strong>
            <ul style="margin: 8px 0 0 20px; color: var(--text-secondary);">
              <li>Encrypted using AES-256-GCM with a distinct 96-bit initialization vector.</li>
              <li>Decrypted only in-memory during review jobs; never logged or sent to browsers.</li>
              <li>You can rotate or delete your key at any time.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Section 2: Review Guide & Rules -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2>Review Style Guide</h2>
            <p class="card-subtitle">Custom standards vectorized with pgvector RAG for relevant retrieval per PR.</p>
          </div>
          <% if (settings.index_status === 'indexed') { %>
            <span class="badge badge-success">Indexed (v<%= settings.guide_version %>)</span>
          <% } else if (settings.index_status === 'failed') { %>
            <span class="badge badge-danger">Index Failed</span>
          <% } else { %>
            <span class="badge badge-warning"><%= settings.index_status || 'Pending' %> (v<%= settings.guide_version %>)</span>
          <% } %>
        </div>

        <div class="card-body">
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-bottom: 14px;">
            Edit your team's code review guidelines below. When you click <strong>Save & Re-Index</strong>, GitPR splits each <code>## </code> rule, generates 768-dimensional vector embeddings, and atomically swaps your rules in the database.
          </p>

          <form action="/settings/guide" method="POST" class="form-stacked">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="installation_id" value="<%= settings.installation_id %>">

            <div class="form-group">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <label for="guide_md" style="font-weight: 600;">Guide Markdown:</label>
                <span id="char-count" style="font-size: 0.82rem; color: var(--text-muted);">
                  Max 20,000 characters &bull; Max 30 rules
                </span>
              </div>
              <textarea
                name="guide_md"
                id="guide_md"
                class="form-control code-editor"
                rows="18"
                maxlength="20000"
                placeholder="# Team Style Guide&#10;&#10;## 1. Rule Title&#10;Explanation...&#10;&#10;### ❌ Bad Example&#10;...&#10;&#10;### ✅ Good Example&#10;..."
                required
              ><%= settings.guide_md || '' %></textarea>
              <div class="editor-counter-bar">
                <span id="live-rule-count">Rules detected: 0 / 30</span>
                <span id="live-char-count">0 / 20,000 chars</span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 14px;">
              <span style="font-size: 0.82rem; color: var(--text-muted);">
                Last updated: <%= settings.updated_at ? new Date(settings.updated_at).toLocaleString() : 'Never' %>
              </span>
              <button type="submit" class="btn btn-primary">Save & Re-Index Guide</button>
            </div>
          </form>

          <div style="background-color: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: var(--radius-sm); padding: 16px; margin-top: 24px; font-size: 0.85rem;">
            <strong style="color: #a5b4fc;">Atomic Re-Indexing & Safety:</strong>
            <ul style="margin: 8px 0 0 20px; color: var(--text-secondary);">
              <li><strong>Zero Partial States:</strong> Rule deletions and re-indexing execute inside a single PostgreSQL transaction. Running reviews see either the complete old guide or the complete new guide.</li>
              <li><strong>Prompt Injection Defense:</strong> Style guide rules are treated as UNTRUSTED DATA in the LLM prompt. Text inside rules cannot override bot system instructions.</li>
              <li><strong>Embedding Dimension:</strong> Generated using Google Gemini 768-dimensional embeddings stored in a pgvector column.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const textarea = document.getElementById("guide_md");
    const ruleCounter = document.getElementById("live-rule-count");
    const charCounter = document.getElementById("live-char-count");

    function updateStats() {
      if (!textarea) return;
      const text = textarea.value || "";
      const chars = text.length;
      const rules = (text.match(/^##\s+.+$/gm) || []).length;

      if (charCounter) {
        charCounter.textContent = `${chars.toLocaleString()} / 20,000 chars`;
        charCounter.style.color = chars > 19000 ? "#f87171" : "#64748b";
      }

      if (ruleCounter) {
        ruleCounter.textContent = `Rules detected: ${rules} / 30`;
        ruleCounter.style.color = rules > 30 ? "#f87171" : "#64748b";
      }
    }

    if (textarea) {
      textarea.addEventListener("input", updateStats);
      updateStats();
    }
  });
</script>

<%- include('partials/footer') %>
