<%- include('partials/header') %>

<main class="container page-content">
  <div class="page-header">
    <div class="page-header-text">
      <h1>Code Review Analytics</h1>
      <p class="subtitle">Review metrics, style violations, and resolution rates.</p>
    </div>
    <% if (installations && installations.length > 0) { %>
      <div class="installation-selector">
        <label for="dashboard-inst-select" class="sr-only">Account:</label>
        <select id="dashboard-inst-select" onchange="window.location.href='/dashboard' + (this.value ? '?installation_id=' + this.value : '')">
          <option value="" <%= !selectedInstallationId ? 'selected' : '' %>>All Accounts</option>
          <% installations.forEach(function(inst) { %>
            <option value="<%= inst.installation_id %>" <%= inst.installation_id == selectedInstallationId ? 'selected' : '' %>>
              <%= inst.account_login %> (#<%= inst.installation_id %>)
            </option>
          <% }); %>
        </select>
      </div>
    <% } %>
  </div>

  <% if (error) { %>
    <div class="alert alert-error">
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (noInstallations) { %>
    <div class="card" style="text-align: center; padding: 40px 20px;">
      <h2>No Repositories Found</h2>
      <p style="color: var(--text-muted); margin-top: 6px;">Install Vigilentia on your GitHub repository to view review metrics.</p>
      <div style="margin-top: 16px;">
        <a href="<%= installUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Install on GitHub</a>
      </div>
    </div>
  <% } else { %>

    <!-- KPI Summary Row -->
    <div class="metrics-ribbon">
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Reviews</span>
        </div>
        <div class="stat-val"><%= (data.recentReviews && data.recentReviews.length) || 0 %></div>
        <div class="stat-desc">Past 30 days</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Comments</span>
        </div>
        <div class="stat-val">
          <%= (data.commentsPerWeek && data.commentsPerWeek.reduce((acc, c) => acc + Number(c.count), 0)) || 0 %>
        </div>
        <div class="stat-desc">Review suggestions</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Fix Rate</span>
        </div>
        <div class="stat-val">
          <%
            const hasDecided = data.outcomeRates && (data.outcomeRates.fixed_count + data.outcomeRates.ignored_count > 0);
            const fixRateDisplay = hasDecided
              ? (data.outcomeRates.fixed_rate ?? data.outcomeRates.fixed_pct ?? 0) + '%'
              : 'N/A';
          %>
          <%= fixRateDisplay %>
        </div>
        <div class="stat-desc">Threads resolved</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Top Rule</span>
        </div>
        <div class="stat-val" style="font-size: 16px; font-weight: 600; line-height: 28px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          <%= (data.topRules && data.topRules[0]) ? data.topRules[0].rule_title : 'None' %>
        </div>
        <div class="stat-desc">
          <%= (data.topRules && data.topRules[0]) ? data.topRules[0].count + ' citations' : 'No violations' %>
        </div>
      </div>
    </div>

    <!-- 3 Panels: Metrics & Charts -->
    <div class="dashboard-grid">
      <!-- Panel 1: Comments per Week -->
      <div class="card chart-card">
        <div class="card-header">
          <div>
            <h2>Comments Per Week</h2>
            <p class="card-subtitle">Weekly review comments (last 12 weeks)</p>
          </div>
        </div>
        <div class="card-body">
          <% if (data.commentsPerWeek && data.commentsPerWeek.length > 0) { %>
            <div class="chart-container">
              <canvas id="commentsPerWeekChart"></canvas>
            </div>
          <% } else { %>
            <div class="chart-empty-state">
              <p>No comments recorded in the last 12 weeks.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Panel 2: Top 5 Rules Triggered -->
      <div class="card chart-card">
        <div class="card-header">
          <div>
            <h2>Top 5 Rules Triggered</h2>
            <p class="card-subtitle">Most cited guidelines</p>
          </div>
        </div>
        <div class="card-body">
          <% if (data.topRules && data.topRules.length > 0) { %>
            <div class="chart-container">
              <canvas id="topRulesChart"></canvas>
            </div>
          <% } else { %>
            <div class="chart-empty-state">
              <p>No rules triggered yet.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Panel 3: Fixed vs Ignored Rate -->
      <div class="card chart-card">
        <div class="card-header">
          <div>
            <h2>Outcome Rate</h2>
            <p class="card-subtitle">Resolved vs unaddressed comments</p>
          </div>
        </div>
        <div class="card-body">
          <%
            const hasDecidedRates = data.outcomeRates && (data.outcomeRates.fixed_count + data.outcomeRates.ignored_count > 0);
            const fixPctDisplay = hasDecidedRates
              ? (data.outcomeRates.fixed_rate ?? data.outcomeRates.fixed_pct ?? 0) + '%'
              : 'N/A';
            const ignoredPctDisplay = hasDecidedRates
              ? (data.outcomeRates.ignored_rate ?? data.outcomeRates.ignored_pct ?? 0) + '%'
              : 'N/A';
          %>
          <div class="rates-summary">
            <div class="rate-stat">
              <span class="stat-number text-success"><%= fixPctDisplay %></span>
              <span class="stat-label">Fixed (<%= (data.outcomeRates && data.outcomeRates.fixed_count) || 0 %>)</span>
            </div>
            <div class="rate-stat">
              <span class="stat-number text-danger"><%= ignoredPctDisplay %></span>
              <span class="stat-label">Ignored (<%= (data.outcomeRates && data.outcomeRates.ignored_count) || 0 %>)</span>
            </div>
            <div class="rate-stat">
              <span class="stat-number text-warning"><%= (data.outcomeRates && data.outcomeRates.open_count) || 0 %></span>
              <span class="stat-label">Open</span>
            </div>
          </div>

          <% if (data.outcomeRates.fixed_count > 0 || data.outcomeRates.ignored_count > 0 || data.outcomeRates.open_count > 0) { %>
            <div class="chart-container" style="height: 210px;">
              <canvas id="outcomeChart"></canvas>
            </div>
          <% } else { %>
            <div class="chart-empty-state" style="padding: 10px 0;">
              <p>No outcomes decided yet.</p>
            </div>
          <% } %>

          <p class="heuristic-note">
            Fixed: PR author resolved comment &bull; Ignored: PR merged or closed with open comment.
          </p>
        </div>
      </div>
    </div>

    <!-- Panel 4: Recent 20 Reviews Audit Table -->
    <div class="card" style="margin-top: 16px;">
      <div class="card-header">
        <div>
          <h2>Recent Reviews</h2>
          <p class="card-subtitle">Last 20 automated reviews</p>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Repository</th>
              <th>PR</th>
              <th>Commit</th>
              <th>Issues</th>
              <th>Latency</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (data.recentReviews && data.recentReviews.length > 0) { %>
              <% data.recentReviews.forEach(function(r) { %>
                <tr>
                  <td style="color: var(--text-dim); white-space: nowrap;">
                    <%= new Date(r.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </td>
                  <td><%= r.repo %></td>
                  <td>
                    <a href="https://github.com/<%= r.repo %>/pull/<%= r.pr_number %>" target="_blank" rel="noopener">
                      #<%= r.pr_number %>
                    </a>
                  </td>
                  <td>
                    <span class="sha-pill"><%= r.head_sha ? r.head_sha.substring(0, 7) : 'head' %></span>
                  </td>
                  <td>
                    <span class="badge badge-secondary"><%= r.comments_posted %></span>
                  </td>
                  <td style="color: var(--text-muted);">
                    <%= r.duration_ms ? (r.duration_ms / 1000).toFixed(1) + 's' : '-' %>
                  </td>
                  <td>
                    <% if (r.status === 'completed') { %>
                      <span class="badge badge-success">completed</span>
                    <% } else if (r.status === 'failed') { %>
                      <span class="badge badge-danger">failed</span>
                    <% } else { %>
                      <span class="badge badge-warning"><%= r.status %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 24px; color: var(--text-dim);">
                  No reviews recorded yet.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const rawData = <%- JSON.stringify(data) %>;

    Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
    Chart.defaults.color = "#a1a1aa";

    const handlePointerHover = (event, elements) => {
      if (event.native && event.native.target) {
        event.native.target.style.cursor = elements && elements.length ? 'pointer' : 'default';
      }
    };

    // 1. Comments per Week Line Chart (Vivid Sky Blue with Glowing Gradient)
    const weeklyCanvas = document.getElementById("commentsPerWeekChart");
    if (weeklyCanvas && rawData.commentsPerWeek && rawData.commentsPerWeek.length > 0) {
      const ctx = weeklyCanvas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 240);
      gradient.addColorStop(0, 'rgba(56, 189, 248, 0.28)');
      gradient.addColorStop(1, 'rgba(56, 189, 248, 0.00)');

      new Chart(weeklyCanvas, {
        type: "line",
        data: {
          labels: rawData.commentsPerWeek.map(d => d.week),
          datasets: [{
            label: "Comments",
            data: rawData.commentsPerWeek.map(d => Number(d.count)),
            borderColor: "#38bdf8",
            borderWidth: 2.5,
            tension: 0.35,
            fill: true,
            backgroundColor: gradient,
            pointBackgroundColor: "#38bdf8",
            pointBorderColor: "#0c0c0c",
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 7,
            pointHoverBackgroundColor: "#ffffff",
            pointHoverBorderColor: "#38bdf8",
            pointHoverBorderWidth: 3,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: "index",
            intersect: false,
          },
          onHover: handlePointerHover,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: "#18181b",
              titleColor: "#ffffff",
              bodyColor: "#e4e4e7",
              borderColor: "#3f3f46",
              borderWidth: 1,
              padding: 10,
              cornerRadius: 6,
              boxPadding: 4,
              callbacks: {
                label: function(context) {
                  const val = context.parsed.y;
                  return ` ${val} review ${val === 1 ? 'comment' : 'comments'}`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: "rgba(255, 255, 255, 0.06)" },
              ticks: { color: "#a1a1aa", font: { size: 11, weight: 500 } }
            },
            y: {
              beginAtZero: true,
              grid: { color: "rgba(255, 255, 255, 0.06)" },
              ticks: { color: "#a1a1aa", precision: 0, font: { size: 11, weight: 500 } }
            }
          }
        }
      });
    }

    // 2. Top 5 Rules Bar Chart (Vibrant Violet / Indigo Palette)
    const topRulesCanvas = document.getElementById("topRulesChart");
    if (topRulesCanvas && rawData.topRules && rawData.topRules.length > 0) {
      const barColors = ["#6366f1", "#8b5cf6", "#a855f7", "#c084fc", "#ec4899"];
      const barHoverColors = ["#818cf8", "#a78bfa", "#c084fc", "#d8b4fe", "#f472b6"];

      new Chart(topRulesCanvas, {
        type: "bar",
        data: {
          labels: rawData.topRules.map(r => r.rule_title.length > 20 ? r.rule_title.slice(0, 18) + "..." : r.rule_title),
          datasets: [{
            data: rawData.topRules.map(r => Number(r.count)),
            backgroundColor: rawData.topRules.map((_, i) => barColors[i % barColors.length]),
            hoverBackgroundColor: rawData.topRules.map((_, i) => barHoverColors[i % barHoverColors.length]),
            borderRadius: 6,
            borderSkipped: false,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          onHover: handlePointerHover,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: "#18181b",
              titleColor: "#ffffff",
              bodyColor: "#e4e4e7",
              borderColor: "#3f3f46",
              borderWidth: 1,
              padding: 10,
              cornerRadius: 6,
              callbacks: {
                title: function(items) {
                  const idx = items[0].dataIndex;
                  return rawData.topRules[idx].rule_title;
                },
                label: function(item) {
                  return ` ${item.parsed.y} ${item.parsed.y === 1 ? 'citation' : 'citations'}`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: {
                color: "#a1a1aa",
                font: { size: 11, weight: 500 },
                maxRotation: 0,
                autoSkip: true,
              }
            },
            y: {
              beginAtZero: true,
              grid: { color: "rgba(255, 255, 255, 0.06)" },
              ticks: { color: "#a1a1aa", precision: 0, font: { size: 11, weight: 500 } }
            }
          }
        }
      });
    }

    // 3. Outcome Breakdown Doughnut Chart (Vivid Semantic Colors & Interactive Pop)
    const outcomeCanvas = document.getElementById("outcomeChart");
    if (outcomeCanvas && (rawData.outcomeRates.fixed_count > 0 || rawData.outcomeRates.ignored_count > 0 || rawData.outcomeRates.open_count > 0)) {
      new Chart(outcomeCanvas, {
        type: "doughnut",
        data: {
          labels: ["Fixed", "Ignored", "Open"],
          datasets: [{
            data: [
              Number(rawData.outcomeRates.fixed_count),
              Number(rawData.outcomeRates.ignored_count),
              Number(rawData.outcomeRates.open_count)
            ],
            backgroundColor: ["#10b981", "#ef4444", "#f59e0b"],
            hoverBackgroundColor: ["#34d399", "#f87171", "#fbbf24"],
            borderColor: "#0c0c0c",
            borderWidth: 3,
            hoverOffset: 8,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "68%",
          onHover: handlePointerHover,
          plugins: {
            legend: {
              position: "bottom",
              labels: {
                color: "#d4d4d8",
                font: { size: 11, weight: 500 },
                padding: 14,
                usePointStyle: true,
                pointStyle: "circle",
              }
            },
            tooltip: {
              backgroundColor: "#18181b",
              titleColor: "#ffffff",
              bodyColor: "#e4e4e7",
              borderColor: "#3f3f46",
              borderWidth: 1,
              padding: 10,
              cornerRadius: 6,
              callbacks: {
                label: function(context) {
                  const total = context.dataset.data.reduce((a, b) => a + Number(b), 0);
                  const val = Number(context.raw);
                  const pct = total > 0 ? ((val / total) * 100).toFixed(0) : 0;
                  return ` ${context.label}: ${val} (${pct}%)`;
                }
              }
            }
          }
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>
