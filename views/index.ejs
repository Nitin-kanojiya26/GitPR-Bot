<%- include('partials/header') %>

<main class="container">
  <section class="hero">
    <div class="hero-pill">
      <span class="hero-pill-dot"></span>
      <span>Autonomous AI Code Reviews • Grounded in Team Standards</span>
    </div>
    <h1>Elevate Code Quality with<br>Context-Aware AI Reviews</h1>
    <p>
      GitPR reviews changed lines in GitHub pull requests, catches critical security flaws and syntax regressions, and strictly enforces your team's custom style guide.
    </p>
    <div class="hero-actions">
      <a href="<%= installUrl %>" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
        <svg height="18" width="18" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        Install on GitHub
      </a>
      <a href="/setup" class="btn btn-secondary btn-lg">Configure Your Key</a>
    </div>
  </section>

  <section class="features">
    <div class="feature-card">
      <div class="feature-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h3>Bring Your Own Gemini Key</h3>
      <p>Zero subscription fees. Connect your free Google Gemini API key. Encrypted with military-grade AES-256-GCM and completely partitioned per tenant.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
      <h3>Custom Style Guides & RAG</h3>
      <p>Write your guidelines in Markdown. PostgreSQL <code>pgvector</code> converts rules to 768-dimensional embeddings to match rules directly against changed code.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
      </div>
      <h3>Four-Panel Analytics</h3>
      <p>Track weekly review volume, top triggered team rules, heuristic fix vs ignore ratios, and inspect full review histories in one clean dashboard.</p>
    </div>
  </section>

  <section class="callout-banner">
    <div>
      <h3>Zero Installation Required</h3>
      <p>
        GitPR is a cloud-hosted GitHub App. Developers on your team never download binaries, configure CLI tools, or modify CI pipelines. Simply click Install, select your repositories, and receive instant reviews on your next Pull Request.
      </p>
    </div>
    <a href="/privacy" class="btn btn-secondary">Read Privacy Architecture &rarr;</a>
  </section>
</main>

<%- include('partials/footer') %>
