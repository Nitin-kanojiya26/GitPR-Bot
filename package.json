{
  "name": "pr-review-bot",
  "version": "1.0.0",
  "description": "AI-powered GitHub Pull Request Review Bot",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "migrate": "node ./lib/db/migrate.js",
    "start": "node ./lib/index.js",
    "test": "vitest run",
    "test:llm": "node scripts/test-llm.js",
    "simulate": "node scripts/simulate.js",
    "seed": "node db/seed.ts",
    "test:rag": "node scripts/test-rag.js",
    "test:rag-review": "node scripts/test-rag-review.js",
    "test:queue": "node scripts/test-queue.js",
    "test:idempotency": "node scripts/test-idempotency.js",
    "test:health": "node scripts/test-health.js",
    "eval:rag": "node evals/eval-rag.js",
    "dev": "probot run ./lib/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bullmq": "^6.5.4",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "parse-diff": "^0.12.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "probot": "^14.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "smee-client": "^5.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
