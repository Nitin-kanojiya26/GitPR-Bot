<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Vigilentia - AI Code Reviewer' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <a href="/" class="brand">
        <svg height="18" width="18" viewBox="0 0 16 16" fill="currentColor">
          <path d="M7.177 3.073L9.573.677A.25.25 0 0110 .854v4.792a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm-2.25.75a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zM11 2.5h-1V4h1a1 1 0 011 1v7a1 1 0 01-1 1h-1v1.5h1a2.5 2.5 0 002.5-2.5V5A2.5 2.5 0 0011 2.5z"></path>
        </svg>
        <span>Vigilentia</span>
      </a>
      <div class="nav-links">
        <a href="/" class="nav-item">Home</a>
        <a href="/setup" class="nav-item">Setup</a>
        <a href="/settings" class="nav-item">Settings</a>
        <a href="/dashboard" class="nav-item">Dashboard</a>
        <a href="/privacy" class="nav-item">Privacy</a>
        <% if (locals.user) { %>
          <span class="user-pill">
            <% if (locals.user.avatar_url) { %>
              <img src="<%= locals.user.avatar_url %>" alt="avatar" class="avatar-sm">
            <% } %>
            <%= locals.user.login %>
          </span>
          <a href="/auth/logout" class="btn btn-secondary btn-sm">Sign Out</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-secondary btn-sm">Sign In</a>
        <% } %>
        <a href="<%= installUrl %>" class="btn btn-primary btn-sm" target="_blank" rel="noopener">Install on GitHub</a>
      </div>
    </div>
  </nav>
