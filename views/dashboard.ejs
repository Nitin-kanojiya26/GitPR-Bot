<%- include('partials/header') %>

<div class="container" style="padding-bottom: 40px;">
  <div class="page-header">
    <div>
      <h1>Code Review Analytics</h1>
      <p class="subtitle">Review metrics, style violations, and resolution rates.</p>
    </div>
    <% if (installations && installations.length > 0) { %>
      <div class="installation-selector">
        <select id="dashboard-inst-select" onchange="window.location.href='/dashboard' + (this.value ? '?installation_id=' + this.value : '')">
          <option value="" <%= !selectedInstallationId ? 'selected' : '' %>>All Accounts</option>
          <% installations.forEach(function(inst) { %>
            <option value="<%= inst.installation_id %>" <%= inst.installation_id == selectedInstallationId ? 'selected' : '' %>>
              <%= inst.account_login %> (#<%= inst.installation_id %>)
            </option>
          <% }); %>
        </select>
      </div>
    <% } %>
  </div>

  <% if (error) { %>
    <div class="alert alert-error">
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (noInstallations) { %>
    <div class="card" style="text-align: center; padding: 40px 20px;">
      <h2>No Repositories Found</h2>
      <p style="color: var(--text-muted); margin-top: 6px;">Install GitPR on your GitHub repository to view review metrics.</p>
      <div style="margin-top: 16px;">
        <a href="<%= installUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Install on GitHub</a>
      </div>
    </div>
  <% } else { %>

    <!-- KPI Summary Row -->
    <div class="metrics-ribbon">
      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Reviews</span>
        </div>
        <div class="stat-val"><%= (data.recentReviews && data.recentReviews.length) || 0 %></div>
        <div class="stat-desc">Past 30 days</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Comments</span>
        </div>
        <div class="stat-val">
          <%= (data.commentsPerWeek && data.commentsPerWeek.reduce((acc, c) => acc + Number(c.count), 0)) || 0 %>
        </div>
        <div class="stat-desc">Review suggestions</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Fix Rate</span>
        </div>
        <div class="stat-val">
          <%= (data.outcomeRates && data.outcomeRates.fixed_pct !== null) ? data.outcomeRates.fixed_pct + '%' : 'N/A' %>
        </div>
        <div class="stat-desc">Threads resolved</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <span class="stat-title">Top Rule</span>
        </div>
        <div class="stat-val" style="font-size: 1rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          <%= (data.topRules && data.topRules[0]) ? data.topRules[0].rule_title : 'None' %>
        </div>
        <div class="stat-desc">
          <%= (data.topRules && data.topRules[0]) ? data.topRules[0].count + ' citations' : 'No violations' %>
        </div>
      </div>
    </div>

    <!-- 3 Panels: Metrics & Charts -->
    <div class="dashboard-grid">
      <!-- Panel 1: Comments per Week -->
      <div class="card chart-card">
        <div class="card-header">
          <div>
            <h2>Comments Per Week</h2>
            <p class="card-subtitle">Weekly review comments (last 12 weeks)</p>
          </div>
        </div>
        <div class="card-body">
          <% if (data.commentsPerWeek && data.commentsPerWeek.length > 0) { %>
            <div class="chart-container">
              <canvas id="commentsPerWeekChart"></canvas>
            </div>
          <% } else { %>
            <div class="chart-empty-state">
              <p>No comments recorded in the last 12 weeks.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Panel 2: Top 5 Rules Triggered -->
      <div class="card chart-card">
        <div class="card-header">
          <div>
            <h2>Top 5 Rules Triggered</h2>
            <p class="card-subtitle">Most cited guidelines</p>
          </div>
        </div>
        <div class="card-body">
          <% if (data.topRules && data.topRules.length > 0) { %>
            <div class="chart-container">
              <canvas id="topRulesChart"></canvas>
            </div>
          <% } else { %>
            <div class="chart-empty-state">
              <p>No rules triggered yet.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Panel 3: Fixed vs Ignored Rate -->
      <div class="card chart-card">
        <div class="card-header">
          <div>
            <h2>Outcome Rate</h2>
            <p class="card-subtitle">Resolved vs unaddressed comments</p>
          </div>
        </div>
        <div class="card-body">
          <div class="rates-summary">
            <div class="rate-stat">
              <span class="stat-number"><%= data.outcomeRates.fixed_pct !== null ? data.outcomeRates.fixed_pct + '%' : 'N/A' %></span>
              <span class="stat-label">Fixed (<%= data.outcomeRates.fixed_count %>)</span>
            </div>
            <div class="rate-stat">
              <span class="stat-number" style="color: var(--text-muted);"><%= data.outcomeRates.ignored_pct !== null ? data.outcomeRates.ignored_pct + '%' : 'N/A' %></span>
              <span class="stat-label">Ignored (<%= data.outcomeRates.ignored_count %>)</span>
            </div>
            <div class="rate-stat">
              <span class="stat-number" style="color: var(--text-dim);"><%= data.outcomeRates.open_count %></span>
              <span class="stat-label">Open</span>
            </div>
          </div>

          <% if (data.outcomeRates.fixed_count > 0 || data.outcomeRates.ignored_count > 0 || data.outcomeRates.open_count > 0) { %>
            <div class="chart-container" style="height: 140px;">
              <canvas id="outcomeChart"></canvas>
            </div>
          <% } else { %>
            <div class="chart-empty-state" style="padding: 10px 0;">
              <p>No outcomes decided yet.</p>
            </div>
          <% } %>

          <p class="heuristic-note">
            Fixed: PR author resolved comment &bull; Ignored: PR merged or closed with open comment.
          </p>
        </div>
      </div>
    </div>

    <!-- Panel 4: Recent 20 Reviews Audit Table -->
    <div class="card" style="margin-top: 16px;">
      <div class="card-header">
        <div>
          <h2>Recent Reviews</h2>
          <p class="card-subtitle">Last 20 automated reviews</p>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Repository</th>
              <th>PR</th>
              <th>Commit</th>
              <th>Issues</th>
              <th>Latency</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (data.recentReviews && data.recentReviews.length > 0) { %>
              <% data.recentReviews.forEach(function(r) { %>
                <tr>
                  <td style="color: var(--text-dim); white-space: nowrap;">
                    <%= new Date(r.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </td>
                  <td><%= r.repo %></td>
                  <td>
                    <a href="https://github.com/<%= r.repo %>/pull/<%= r.pr_number %>" target="_blank" rel="noopener">
                      #<%= r.pr_number %>
                    </a>
                  </td>
                  <td>
                    <span class="sha-pill"><%= r.head_sha ? r.head_sha.substring(0, 7) : 'head' %></span>
                  </td>
                  <td>
                    <span class="badge badge-secondary"><%= r.comments_posted %></span>
                  </td>
                  <td style="color: var(--text-muted);">
                    <%= r.duration_ms ? (r.duration_ms / 1000).toFixed(1) + 's' : '-' %>
                  </td>
                  <td>
                    <% if (r.status === 'completed') { %>
                      <span class="badge badge-success">completed</span>
                    <% } else if (r.status === 'failed') { %>
                      <span class="badge badge-danger">failed</span>
                    <% } else { %>
                      <span class="badge badge-warning"><%= r.status %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 24px; color: var(--text-dim);">
                  No reviews recorded yet.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const rawData = <%- JSON.stringify(data) %>;

    Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    Chart.defaults.color = "#888888";

    // 1. Comments per Week Line Chart (Monochrome clean white line)
    const weeklyCanvas = document.getElementById("commentsPerWeekChart");
    if (weeklyCanvas && rawData.commentsPerWeek && rawData.commentsPerWeek.length > 0) {
      new Chart(weeklyCanvas, {
        type: "line",
        data: {
          labels: rawData.commentsPerWeek.map(d => d.week),
          datasets: [{
            label: "Comments",
            data: rawData.commentsPerWeek.map(d => d.count),
            borderColor: "#e5e5e5",
            borderWidth: 1.5,
            tension: 0.1,
            fill: false,
            pointBackgroundColor: "#ffffff",
            pointRadius: 3,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: "#1c1c1c" }, ticks: { color: "#666666" } },
            y: { beginAtZero: true, grid: { color: "#1c1c1c" }, ticks: { color: "#666666", precision: 0 } }
          }
        }
      });
    }

    // 2. Top 5 Rules Bar Chart (Monochrome gray bars)
    const topRulesCanvas = document.getElementById("topRulesChart");
    if (topRulesCanvas && rawData.topRules && rawData.topRules.length > 0) {
      new Chart(topRulesCanvas, {
        type: "bar",
        data: {
          labels: rawData.topRules.map(r => r.rule_title.length > 25 ? r.rule_title.slice(0, 22) + "..." : r.rule_title),
          datasets: [{
            data: rawData.topRules.map(r => r.count),
            backgroundColor: "#333333",
            hoverBackgroundColor: "#555555",
            borderRadius: 3,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: function(items) {
                  const idx = items[0].dataIndex;
                  return rawData.topRules[idx].rule_title;
                }
              }
            }
          },
          scales: {
            x: { grid: { display: false }, ticks: { color: "#666666", font: { size: 10 } } },
            y: { beginAtZero: true, grid: { color: "#1c1c1c" }, ticks: { color: "#666666", precision: 0 } }
          }
        }
      });
    }

    // 3. Outcome Breakdown Doughnut Chart (Minimal Monochrome)
    const outcomeCanvas = document.getElementById("outcomeChart");
    if (outcomeCanvas && (rawData.outcomeRates.fixed_count > 0 || rawData.outcomeRates.ignored_count > 0 || rawData.outcomeRates.open_count > 0)) {
      new Chart(outcomeCanvas, {
        type: "doughnut",
        data: {
          labels: ["Fixed", "Ignored", "Open"],
          datasets: [{
            data: [
              rawData.outcomeRates.fixed_count,
              rawData.outcomeRates.ignored_count,
              rawData.outcomeRates.open_count
            ],
            backgroundColor: ["#ffffff", "#555555", "#222222"],
            borderColor: "#121212",
            borderWidth: 2,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "bottom",
              labels: { color: "#888888", font: { size: 10 }, boxWidth: 10 }
            }
          }
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>
