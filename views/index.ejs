<%- include('partials/header') %>

<main class="container">
  <section class="hero">
    <div class="hero-tag">GitHub App &bull; AI Code Reviewer</div>
    <h1>Automated code reviews for GitHub pull requests.</h1>
    <p>
      Vigilentia reviews changed lines in pull requests, catches bugs and vulnerabilities, and enforces your team's custom style standards.
    </p>
    <div class="hero-actions">
      <a href="<%= installUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Install on GitHub</a>
      <a href="/setup" class="btn btn-secondary">Configure Key</a>
    </div>
  </section>

  <section class="features">
    <div class="feature-card">
      <h3>Bring Your Own Gemini Key</h3>
      <p>Zero subscription fees. Connect your free Google Gemini API key, encrypted with AES-256-GCM.</p>
    </div>

    <div class="feature-card">
      <h3>Custom Style Guides & RAG</h3>
      <p>Edit guidelines in Markdown. PostgreSQL pgvector matches relevant rules directly against changed files.</p>
    </div>

    <div class="feature-card">
      <h3>Four-Panel Analytics</h3>
      <p>Track weekly review volume, top cited style rules, fix vs ignore ratios, and full review history.</p>
    </div>
  </section>

  <section class="callout-banner">
    <div>
      <h3>Zero Installation Required</h3>
      <p>
        Cloud-hosted GitHub App. Developers on your team never download binaries or modify CI pipelines. Install on your repo to receive automated reviews.
      </p>
    </div>
    <a href="/privacy" class="btn btn-secondary btn-sm">Privacy Details &rarr;</a>
  </section>
</main>

<%- include('partials/footer') %>
